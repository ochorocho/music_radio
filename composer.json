{
	"name": "nextcloud/music_radio",
	"description": "Synchronized radio channels built from your own music",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Jochen Roth"
		}
	],
	"require": {
		"php": "^8.1",
		"james-heinrich/getid3": "^1.9"
	},
	"require-dev": {
		"nextcloud/coding-standard": "^1.3.2",
		"nextcloud/ocp": "dev-master",
		"phpstan/phpstan": "^2",
		"phpunit/phpunit": "^11.5"
	},
	"scripts": {
		"lint": "find . -name \\*.php -not -path './composer/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"phpstan": "phpstan analyse",
		"test:unit": "phpunit --config tests/phpunit.xml"
	},
	"autoload": {
		"psr-4": {
			"OCA\\MusicRadio\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\MusicRadio\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.3"
		},
		"sort-packages": true,
		"vendor-dir": "composer"
	}
}
