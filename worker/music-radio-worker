def install(args) -> int:
    """
    Make this machine into a worker.

    Idempotent, and never destructive: everything it writes it checks for first, and the one
    file it will not replace without being told twice is the password. Re-running it after
    changing something is the intended way to use it, not a risk.

    What it does *not* do is install system packages. ffmpeg and a JavaScript runtime are
    root-level changes to a machine, and on two distributions ffmpeg needs a third-party
    repository enabled first — a decision that belongs to whoever runs the box. So those are
    reported, with the exact command, and the final check says they are still missing.
    """
    layout = Layout(root=os.geteuid() == 0)
    systemd = Systemd(layout, args.dry_run)
    packages = Packages()

    log(f"installing as {'root' if layout.root else os.environ.get('USER') or 'this user'}"
        f"{' (dry run — nothing will be written)' if args.dry_run else ''}")
    log(f"python:     {sys.version.split()[0]}")

    # --- what is already here ------------------------------------------------
    tools = discover_tools(args, required=False)
    log(f"ffmpeg:     {tools.ffmpeg_dir or 'not found'}")
    log(f"javascript: {tools.js_spec or 'not found'}")
    packages.advise(need_ffmpeg=tools.ffmpeg_dir is None, need_js=tools.js_runtime is None)

    # --- yt-dlp --------------------------------------------------------------
    if tools.yt_dlp and not args.force:
        log(f"yt-dlp:     {tools.yt_dlp} ({tools.version()}) — already installed")
    elif args.dry_run:
        log(f"  would install yt-dlp ({YtDlp.asset_here()}) at {layout.yt_dlp}")
    else:
        log(f"→ downloading yt-dlp ({YtDlp.asset_here()})")
        installed = YtDlp.install(layout.yt_dlp)
        if installed is None:
            return 1
        version, asset = installed
        log(f"  installed yt-dlp {version} ({asset}) at {layout.yt_dlp}")

    # --- the account ---------------------------------------------------------
    if layout.root:
        create_service_account(layout, args.dry_run)

    # --- credentials ---------------------------------------------------------
    server, user, password = collect_credentials(args, layout)
    if server is None:
        return 1

    write_config(layout, args, server, user, password)

    # --- this script ---------------------------------------------------------
    install_self(layout, args.dry_run)

    # --- the service ---------------------------------------------------------
    if args.no_systemd or not systemd.available:
        log("systemd: not available here, so no service was installed.")
        log(f"  run the worker with: {layout.script}")
    else:
        install_units(layout, systemd, args)

    # --- and does it work? ---------------------------------------------------
    if args.dry_run:
        log("dry run finished — nothing was written")
        return 0

    # Before the check below, which runs as root and therefore cannot discover this.
    check_service_can_read(layout)

    log("")
    api = Api(server, user, password)
    return check(api, discover_tools(args, required=False), build_cache(args), args)


def create_service_account(layout: Layout, dry_run: bool) -> None:
    """An account with no home, no shell and nothing else to do."""
    import pwd

    try:
        pwd.getpwnam(Layout.SERVICE_USER)
        log(f"account:    {Layout.SERVICE_USER} — already exists")
        return
    except KeyError:
        pass

    command = ["useradd", "--system", "--no-create-home", "--shell", "/usr/sbin/nologin",
               Layout.SERVICE_USER]
    if dry_run:
        log(f"  would run {' '.join(command)}")
        return

    try:
        done = subprocess.run(command, capture_output=True, text=True, timeout=60)
    except Exception as error:  # noqa: BLE001
        log(f"could not create the {Layout.SERVICE_USER} account: {error}")
        return

    if done.returncode != 0:
        log(f"could not create the {Layout.SERVICE_USER} account: "
            f"{done.stderr.strip() or done.stdout.strip()}")
        return

    log(f"→ created the {Layout.SERVICE_USER} account")


def collect_credentials(args, layout: Layout) -> tuple[str | None, str, str]:
    """
    What the worker signs in with, from the flags, the environment, or a person.

    An existing password file counts as an answer, so re-running install on a configured
    machine asks nothing.
    """
    import getpass

    server = (args.server or "").rstrip("/")
    user = args.user or ""
    password = args.password or ""

    if args.password_file and not password:
        try:
            with open(args.password_file, encoding="utf-8") as file:
                password = file.read().strip()
        except OSError as error:
            log(f"could not read {args.password_file}: {error}")

    if not password and os.path.isfile(layout.password_file) and not args.force:
        try:
            with open(layout.password_file, encoding="utf-8") as file:
                password = file.read().strip()
            log(f"password:   kept the one already in {layout.password_file}")
        except OSError:
            pass

    interactive = sys.stdin.isatty() and not args.dry_run

    if not server and interactive:
        server = input("Nextcloud URL (https://cloud.example.com): ").strip().rstrip("/")
    if not user and interactive:
        user = input("worker account [radio-worker]: ").strip() or "radio-worker"
    if not password and interactive:
        # Never echoed, and never passed as an argument — a command line is visible in ps.
        password = getpass.getpass("app password (occ user:add-app-password): ").strip()

    if not server:
        log("no server given. Use --server, or set MUSIC_RADIO_SERVER.")
        return None, user, password
    if not https_enough(server):
        log("the server URL must be https:// — the app password is sent with every request.")
        return None, user, password
    if not user:
        log("no account given. Use --user, or set MUSIC_RADIO_USER.")
        return None, user, password
    if not password:
        log("no app password given. Make one on the server with: "
            f"occ user:add-app-password {user}")
        return None, user, password

    return server, user, password


def write_config(layout: Layout, args, server: str, user: str, password: str) -> None:
    """The env file and the password, with the permissions each of them needs."""
    if not args.dry_run:
        prepare_config_dir(layout)

    body = (ENV_TEMPLATE
            .replace("@SERVER@", server)
            .replace("@USER@", user)
            .replace("@PASSWORD_FILE@", layout.password_file)
            .replace("@NAME@", socket.gethostname())
            .replace("@YTDLP@", layout.yt_dlp))

    # The existence rules are checked before the dry run reports anything, so what it says
    # is what a real run would do — a dry run that promises to write a file it would in fact
    # leave alone is worse than no dry run.
    if os.path.isfile(layout.env_file) and not args.force:
        log(f"config:     {layout.env_file} — left alone (--force to replace)")
    elif args.dry_run:
        log(f"  would write {layout.env_file}")
    else:
        write_private(layout.env_file, body, 0o640, layout.service_user, group_only=True)
        log(f"→ wrote {layout.env_file}")

    # The one file that is never replaced by accident. Its content is a credential, and an
    # install re-run with an empty prompt must not blank it.
    if os.path.isfile(layout.password_file) and not args.force:
        log(f"password:   {layout.password_file} — left alone (--force to replace)")
        return

    if args.dry_run:
        log(f"  would write {layout.password_file}")
        return

    write_private(layout.password_file, password + "\n", 0o600, layout.service_user)
    log(f"→ wrote {layout.password_file}")


def prepare_config_dir(layout: Layout) -> None:
    """
    The directory the credentials live in, owned so that the service can get at them.

    The group is the point, and it is easy to get wrong in a way that looks right: a
    password file owned by the service account with mode 0600 is still unreadable to it if
    the directory above is `root:root 0750`, because reading a file means traversing every
    directory on the way to it. That produces a worker that installs cleanly, passes its own
    check as root, and then fails at startup with a permission error naming a file whose
    permissions are perfectly correct.

    So the directory is `root:<service account> 0750`: nobody else can look in it, and the
    one account that has to can.

    Set on every install rather than only at creation, because a directory left behind by an
    earlier version is exactly the case that needs fixing.
    """
    os.makedirs(layout.config_dir, exist_ok=True)
    os.chmod(layout.config_dir, 0o750)

    if layout.service_user is None:
        return

    try:
        shutil.chown(layout.config_dir, "root", layout.service_user)
    except (LookupError, PermissionError, OSError) as error:
        log(f"  could not set ownership on {layout.config_dir}: {error}")


def readable_by(path: str, uid: int, gid: int) -> bool:
    """
    Whether this account could actually open that file.

    Walks the whole path, because permission to read a file is permission to traverse every
    directory above it — the part that had to be learned the hard way. Groups beyond the
    account's primary one are consulted too, so an administrator who has arranged access
    some other way is not told they have not.
    """
    def allowed(target: str, need: int) -> bool:
        try:
            info = os.stat(target)
        except OSError:
            return False

        if uid == 0:
            return True
        if info.st_uid == uid:
            return bool(info.st_mode & (need << 6))
        if info.st_gid == gid or info.st_gid in supplementary_groups(uid):
            return bool(info.st_mode & (need << 3))

        return bool(info.st_mode & need)

    # 4 is read, 1 is execute — which on a directory means "may be traversed".
    if not allowed(path, 4):
        return False

    directory = os.path.dirname(os.path.abspath(path))
    while True:
        if not allowed(directory, 1):
            return False
        parent = os.path.dirname(directory)
        if parent == directory:
            return True
        directory = parent


def supplementary_groups(uid: int) -> list[int]:
    try:
        import grp
        import pwd

        name = pwd.getpwuid(uid).pw_name

        return [group.gr_gid for group in grp.getgrall() if name in group.gr_mem]
    except Exception:  # noqa: BLE001
        return []


def check_service_can_read(layout: Layout) -> None:
    """
    Prove the account the service runs as can read what the service needs.

    Checked here because the alternative place to find out is `journalctl` after a failed
    start, and because everything else `install` does it does as root — which can read
    anything and therefore proves nothing.
    """
    if layout.service_user is None:
        return

    try:
        import pwd

        account = pwd.getpwnam(layout.service_user)
    except (KeyError, ImportError):
        return

    for path in (layout.password_file, layout.env_file):
        if os.path.isfile(path) and not readable_by(path, account.pw_uid, account.pw_gid):
            log(f"warning: {layout.service_user} cannot read {path}, so the service will not "
                f"start. Check the ownership of {os.path.dirname(path)}.")


def write_private(path: str, body: str, mode: int, owner: str | None, group_only: bool = False) -> None:
    """
    Write a secret, locked down before a byte of it exists.

    Created empty with the right mode rather than written and chmod'ed after: the other
    order leaves the contents readable for the width of that gap.
    """
    handle = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(handle, "w", encoding="utf-8") as file:
        file.write(body)
    os.chmod(path, mode)

    if owner is None:
        return

    try:
        # The env file is root's, readable by the group the service runs as; the password
        # belongs to the service account outright.
        shutil.chown(path, "root" if group_only else owner, owner)
    except (LookupError, PermissionError, OSError) as error:
        log(f"  could not set ownership on {path}: {error}")


def install_self(layout: Layout, dry_run: bool) -> None:
    """Put this script where the unit expects to find it."""
    source = os.path.abspath(__file__)
    if source == layout.script:
        log(f"script:     {layout.script} — already in place")
        return

    if dry_run:
        log(f"  would copy this script to {layout.script}")
        return

    os.makedirs(os.path.dirname(layout.script), exist_ok=True)
    shutil.copyfile(source, layout.script)
    os.chmod(layout.script, 0o755)
    log(f"→ installed this script at {layout.script}")


def unit_files(layout: Layout) -> list[tuple[str, str]]:
    """
    The units `install` writes, each with the name it is written under.

    One place that fills in the placeholders, because `install` and `--print-unit` have to
    agree about what they are — a preview that differs from what is installed is worse than
    no preview.
    """
    account = ""
    if layout.service_user:
        account = (f"# A user of its own, with no login and nothing else to do. The worker needs "
                   f"only to\n# run yt-dlp and reach the network.\n"
                   f"User={layout.service_user}\nGroup={layout.service_user}\n")

    return [
        ("music-radio-worker.service", WORKER_UNIT
         .replace("@ACCOUNT@", account)
         .replace("@ENV_FILE@", layout.env_file)
         .replace("@SCRIPT@", layout.script)
         .replace("@WANTEDBY@", layout.wanted_by)),
        ("music-radio-worker-update.service", UPDATE_UNIT.replace("@SCRIPT@", layout.script)),
        ("music-radio-worker-update.timer", UPDATE_TIMER),
    ]


def install_units(layout: Layout, systemd: Systemd, args) -> bool:
    """The worker service, and the timer that keeps it current."""
    for name, body in unit_files(layout):
        if args.no_timer and "update" in name:
            continue

        path = os.path.join(layout.unit_dir, name)
        # The same rule the env file gets, and for the same reason: somebody who has edited
        # a unit — a different interval, an added dependency, a proxy variable — should not
        # lose it to a re-run.
        if os.path.isfile(path) and not args.force:
            log(f"unit:       {path} — left alone (--force to replace)")
            continue

        systemd.write(name, body)

    systemd.run("daemon-reload")

    if args.no_start:
        log("  not started (--no-start). Start it with: "
            f"systemctl {'--user ' if not layout.root else ''}enable --now music-radio-worker")
        return False

    # Reported from what actually happened, not from having tried. A worker that failed to
    # start and said it was running is the one message here that would send somebody looking
    # in the wrong place.
    started = systemd.run("enable", "--now", "music-radio-worker.service")
    if not args.no_timer:
        systemd.run("enable", "--now", "music-radio-worker-update.timer")

    if started:
        log("→ the worker is running; follow it with: journalctl -fu music-radio-worker")
    else:
        log("  the service was installed but would not start; see: "
            "systemctl status music-radio-worker")

    return started


# ---------------------------------------------------------------- keeping up


def update(args) -> int:
    """
    Keep this machine current: yt-dlp, this script, and the prerequisites.

    Written to be *cheap when there is nothing to do*, because a timer runs it every quarter
    of an hour. The two questions it asks — has the release changed, has the server's copy
    of this script changed — are both answered by a few kilobytes, and nothing is downloaded
    until one of them says yes. With `--quiet` a run that changed nothing prints nothing at
    all, so the journal stays readable.
    """
    layout = Layout(root=os.geteuid() == 0)
    systemd = Systemd(layout, args.dry_run)
    changed = False

    def say(message: str) -> None:
        if not args.quiet:
            log(message)

    # --- this script ---------------------------------------------------------
    # A server that cannot be reached is not a reason to skip the rest. The two halves of
    # this command are independent, and the yt-dlp half is the one that fails imports when
    # it is left undone.
    if args.script:
        changed = bool(update_script(args, layout, systemd)) or changed

    # --- yt-dlp --------------------------------------------------------------
    target = existing_managed_ytdlp() or layout.yt_dlp
    asset = YtDlp.asset_here()
    if asset is None:
        log("no yt-dlp build is published for this machine; install one yourself")
        return 1

    published = YtDlp.published_checksum(asset)
    if published is None:
        return 1

    if not args.force and sha256_of(target) == published:
        say(f"yt-dlp is current at {target}")
    elif args.dry_run:
        log(f"would update yt-dlp at {target}")
    else:
        before = Tools(target, "", None).version() if os.path.isfile(target) else "none"
        installed = YtDlp.install(target, expected=published)
        if installed is None:
            return 1
        version, asset = installed
        log(f"updated yt-dlp {before} → {version} ({asset}) at {target}")
        changed = True

    # A worker in use elsewhere would otherwise be updated invisibly and never used.
    in_use = discover_tools(args, required=False).yt_dlp
    if in_use and os.path.abspath(in_use) != os.path.abspath(target):
        log(f"note: imports use {in_use}, not the copy this command manages ({target}).")

    # --- the prerequisites ---------------------------------------------------
    tools = discover_tools(args, required=False)
    if tools.ffmpeg_dir is None or tools.js_runtime is None:
        Packages().advise(need_ffmpeg=tools.ffmpeg_dir is None, need_js=tools.js_runtime is None)
        changed = True

    if sys.version_info < YtDlp.MIN_PYTHON:
        log(f"warning: python {'.'.join(map(str, sys.version_info[:2]))} is older than "
            f"{'.'.join(map(str, YtDlp.MIN_PYTHON))}, which yt-dlp needs")

    # --- and the server ------------------------------------------------------
    protocol = args.__dict__.get("_server_protocol")
    if protocol is not None and protocol != PROTOCOL:
        log(f"warning: the server speaks protocol {protocol} and this worker speaks "
            f"{PROTOCOL}. Update whichever is behind.")

    if not changed:
        say("nothing to do")

    return 0


def update_script(args, layout: Layout, systemd: Systemd) -> bool | None:
    """
    Take the worker script the server ships, when it differs from this one.

    The server holds the copy that matches its own protocol, so this is what keeps a worker
    installed months ago from drifting out of step. It is also, plainly, the server deciding
    what code this machine runs — so the bytes are checked against the checksum it declared,
    they have to compile, and the previous script is kept as `.bak`. `--no-script` turns the
    whole thing off.

    @return whether anything changed, or None on a failure worth exiting for
    """
    if not args.server or not args.user:
        # Never installed, or installed without credentials. Nothing to check against.
        return None

    try:
        password = read_password(args)
    except SystemExit:
        return None

    api = Api(args.server, args.user, password)

    try:
        status = api.call("GET", "")
    except Exception as error:  # noqa: BLE001
        log(f"could not reach the server: {error}")
        return None

    # Stashed for the protocol warning at the end, so this stays one round trip.
    args.__dict__["_server_protocol"] = status.get("protocol")

    offered = status.get("workerScript") or {}
    wanted = offered.get("sha256")
    if not wanted:
        # An install with no worker directory. Nothing to update to, and not a fault.
        return False

    mine = sha256_of(os.path.abspath(__file__))
    if mine == wanted:
        return False

    if args.dry_run:
        log(f"would replace this script with the server's copy ({offered.get('version')})")
        return True

    try:
        answer = api.call("GET", "/script")
    except Exception as error:  # noqa: BLE001
        log(f"could not fetch the worker script: {error}")
        return None

    body = answer.get("script") or ""
    encoded = body.encode()

    if hashlib.sha256(encoded).hexdigest() != wanted:
        log("the worker script the server sent does not match the checksum it declared, "
            "so it was discarded")
        return None

    try:
        compile(body, "music-radio-worker", "exec")
    except SyntaxError as error:
        log(f"the worker script the server sent will not compile ({error}); keeping this one")
        return None

    target = layout.script if os.path.isfile(layout.script) else os.path.abspath(__file__)

    try:
        shutil.copyfile(target, target + ".bak")
        staging = target + ".new"
        with open(staging, "wb") as file:
            file.write(encoded)
        os.chmod(staging, 0o755)
        os.replace(staging, target)
    except OSError as error:
        log(f"could not replace {target}: {error}")
        return None

    log(f"updated the worker script to {offered.get('version')} at {target} "
        f"(previous kept as {os.path.basename(target)}.bak)")

    # The running worker has already read its own code, so nothing changes until it is
    # restarted. Safe at any moment: SIGTERM makes it hand its current job back first.
    if systemd.available and systemd.is_active("music-radio-worker.service"):
        systemd.run("restart", "music-radio-worker.service")
        log("  restarted the worker")

    return True


def read_env_file(path: str) -> dict:
    """The KEY=VALUE lines of an env file, and nothing cleverer."""
    values = {}
    try:
        with open(path, encoding="utf-8") as file:
            for line in file:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                values[key.strip()] = value.strip().strip('"').strip("'")
    except OSError:
        return {}

    return values


def load_installed_config(args) -> None:
    """
    Fill in whatever an earlier install already answered.

    Two things need this. Re-running `install` on a configured machine should not ask again
    for a URL that is written down three lines away — and the update timer runs
    `music-radio-worker update` as a systemd oneshot with *no* EnvironmentFile, which is
    deliberate (it runs as root, the worker does not) but leaves it with no idea which
    server to ask about a new script.

    Anything given explicitly wins; this only supplies what is missing.
    """
    layouts = [Layout(root=True), Layout(root=False)]
    if os.geteuid() != 0:
        layouts.reverse()

    for layout in layouts:
        values = read_env_file(layout.env_file)
        if not values:
            continue

        args.server = args.server or values.get("MUSIC_RADIO_SERVER", "")
        args.user = args.user or values.get("MUSIC_RADIO_USER", "")
        args.password_file = args.password_file or values.get("MUSIC_RADIO_PASSWORD_FILE", "")
        if not args.password_file and os.path.isfile(layout.password_file):
            args.password_file = layout.password_file
        break


def existing_managed_ytdlp() -> str | None:
    """The managed copy that is actually here, whichever layout installed it."""
    for path in managed_ytdlp_paths():
        if os.path.isfile(path):
            return path

    return None


def https_enough(server: str) -> bool:
    # The app password travels on every request. Over plain HTTP it travels in the clear,
    # which is not a trade-off worth offering silently — but a development instance on this
    # machine is not the internet.
    return server.startswith("https://") or "localhost" in server or "ddev.site" in server


def die(message: str) -> None:
    log(f"error: {message}")
    sys.exit(1)


def read_password(args) -> str:
    if args.password_file:
        try:
            with open(args.password_file, encoding="utf-8") as file:
                return file.read().strip()
        except OSError as error:
            die(f"could not read {args.password_file}: {error}")
    if args.password:
        return args.password
    die("no app password given. Use --password-file, or set MUSIC_RADIO_PASSWORD.")
    raise AssertionError("unreachable")


def parse_args(argv: list[str]):
    parser = argparse.ArgumentParser(
        prog="music-radio-worker",
        description="Fetch queued Music Radio imports for a Nextcloud server.",
        epilog="With no command, collects jobs until stopped.",
    )
    # A positional verb rather than a flag per action, and optional so that the bare
    # invocation the systemd unit uses keeps working untouched.
    parser.add_argument("command", nargs="?", default="run",
                        choices=("run", "check", "install", "update"),
                        help="run (default), check, install, or update")

    parser.add_argument("--server", default=os.environ.get("MUSIC_RADIO_SERVER", ""),
                        help="Nextcloud base URL, e.g. https://cloud.example.com")
    parser.add_argument("--user", default=os.environ.get("MUSIC_RADIO_USER", ""),
                        help="the Nextcloud account this worker signs in as")
    parser.add_argument("--password", default=os.environ.get("MUSIC_RADIO_PASSWORD", ""),
                        help="its app password (prefer --password-file)")
    parser.add_argument("--password-file", default=os.environ.get("MUSIC_RADIO_PASSWORD_FILE", ""),
                        help="a file containing the app password")
    parser.add_argument("--name", default=os.environ.get("MUSIC_RADIO_WORKER_NAME", socket.gethostname()),
                        help="what this worker calls itself in the queue")
    parser.add_argument("--yt-dlp", default=os.environ.get("MUSIC_RADIO_YTDLP", ""),
                        help="path to yt-dlp (default: the managed copy, else PATH)")
    parser.add_argument("--ffmpeg", default=os.environ.get("MUSIC_RADIO_FFMPEG", ""),
                        help="path to ffmpeg (default: found on PATH)")
    parser.add_argument("--js-runtime", default=os.environ.get("MUSIC_RADIO_JS_RUNTIME", ""),
                        help="path to deno, node, quickjs or bun (default: found on PATH)")
    parser.add_argument("--poll-interval", type=float,
                        default=float(os.environ.get("MUSIC_RADIO_POLL_INTERVAL", "5")),
                        help="seconds to wait when the queue is empty (default: 5)")
    parser.add_argument("--work-dir",
                        default=os.environ.get("MUSIC_RADIO_WORK_DIR", "") or default_work_dir(),
                        help="where to download (default: the service's runtime directory, "
                             "or the system temporary directory)")
    parser.add_argument("--cache-dir", default=os.environ.get("MUSIC_RADIO_CACHE_DIR", ""),
                        help=f"where to keep finished audio (default: {default_cache_dir()})")
    parser.add_argument("--cache-max-mb", type=int,
                        default=int(os.environ.get("MUSIC_RADIO_CACHE_MAX_MB", "2048")),
                        help="how much audio to keep, in megabytes; 0 keeps none (default: 2048)")
    parser.add_argument("--once", action="store_true", help="do one job, then exit")
    parser.add_argument("--check", action="store_true",
                        help="the same as the check command, kept for older scripts")
    parser.add_argument("--verbose", action="store_true", help="say what is happening")

    setup = parser.add_argument_group("install and update")
    setup.add_argument("--dry-run", action="store_true",
                       help="say what would be done, write nothing")
    setup.add_argument("--force", action="store_true",
                       help="replace files install would otherwise leave alone, including "
                            "the stored password")
    setup.add_argument("--no-systemd", action="store_true",
                       help="do not install or touch any service units")
    setup.add_argument("--no-start", action="store_true",
                       help="install the units but do not enable or start them")
    setup.add_argument("--no-timer", action="store_true",
                       help="do not install the quarter-hourly update timer")
    setup.add_argument("--no-script", dest="script", action="store_false",
                       default=os.environ.get("MUSIC_RADIO_SELF_UPDATE", "1") != "0",
                       help="do not let update replace this script with the server's copy")
    setup.add_argument("--quiet", action="store_true",
                       help="update prints only what changed (what the timer uses)")
    setup.add_argument("--print-unit", action="store_true",
                       help="print the systemd units install would write, and exit")
    setup.add_argument("--print-env", action="store_true",
                       help="print the environment file install would write, and exit")

    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    global _verbose

    args = parse_args(argv)
    _verbose = args.verbose
    command = "check" if args.check else args.command

    # Answered before anything else, and without credentials: this is how somebody reads a
    # unit file before letting it near their machine.
    if args.print_unit or args.print_env:
        return print_templates(args)

    # These two set the machine up, so they cannot ask it to be set up first — but they can
    # read what a previous install wrote, which is how the update timer knows anything at
    # all and how a re-run of install stops asking questions it already has answers to.
    if command in ("install", "update"):
        load_installed_config(args)

        return install(args) if command == "install" else update(args)

    if not args.server:
        die("no server given. Use --server, or set MUSIC_RADIO_SERVER.")
    if not https_enough(args.server):
        die("the server URL must be https:// — the app password is sent with every request.")
    if not args.user:
        die("no account given. Use --user, or set MUSIC_RADIO_USER.")

    api = Api(args.server, args.user, read_password(args))
    tools = discover_tools(args)
    cache = build_cache(args)

    if command == "check":
        return check(api, tools, cache, args)

    for name in (signal.SIGINT, signal.SIGTERM):
        signal.signal(name, lambda *_: _stopping.set())

    return Worker(api, tools, cache, args.name, args).run_forever()


def build_cache(args) -> Cache:
    return Cache(args.cache_dir or default_cache_dir(), max(0, args.cache_max_mb) * 1024 * 1024)


def print_templates(args) -> int:
    """
    The units and the env file, exactly as install would write them.

    Each is preceded by the path it belongs at, written as a comment — which both says where
    to put it and gives somebody splitting the output by hand an obvious place to cut. A
    comment rather than a bare line because `#` is a comment in unit files and in env files
    alike, so a chunk pasted along with its header is still a valid file.
    """
    layout = Layout(root=os.geteuid() == 0)

    def announce(path: str) -> None:
        print(f"# ==== {path} " + "=" * max(4, 78 - len(path)))

    if args.print_unit:
        for name, body in unit_files(layout):
            announce(os.path.join(layout.unit_dir, name))
            print(body)

    if args.print_env:
        announce(layout.env_file)
        print(ENV_TEMPLATE
              .replace("@SERVER@", args.server or "https://cloud.example.com")
              .replace("@USER@", args.user or "radio-worker")
              .replace("@PASSWORD_FILE@", layout.password_file)
              .replace("@NAME@", socket.gethostname())
              .replace("@YTDLP@", layout.yt_dlp))

    return 0


def check(api: Api, tools: Tools, cache: Cache, args) -> int:
    """Everything somebody setting this up needs to see, in one place."""
    log(f"yt-dlp:     {tools.yt_dlp} ({tools.version()})")
    log(f"ffmpeg:     {tools.ffmpeg_dir}")
    log(f"javascript: {tools.js_spec or 'none — YouTube will refuse some downloads'}")
    log(f"cache:      {cache.summary()}")

    try:
        status = api.call("GET", "")
    except ApiError as error:
        if error.status == 401:
            log("credentials: refused. Check the account and the app password.")
        elif error.status == 403:
            log(f"credentials: accepted, but '{args.user}' is not on the worker allow-list. "
                f"Add it in Settings → Administration → Music Radio.")
        else:
            log(f"server: {error}")
        return 1
    except Exception as error:  # noqa: BLE001
        log(f"server: could not be reached ({error})")
        return 1

    log(f"account:    {status.get('account')} (accepted)")
    log(f"mode:       {status.get('mode')}")
    log(f"imports:    {'available' if status.get('available') else 'unavailable — ' + str(status.get('reason'))}")
    log(f"queue:      {status.get('queue', {}).get('queued', 0)} waiting, "
        f"{status.get('queue', {}).get('running', 0)} running")
    log(f"cookies:    {'forwarded to workers' if status.get('cookieForwarding') else 'not forwarded'}")

    if status.get("protocol") != PROTOCOL:
        log(f"warning: the server speaks protocol {status.get('protocol')}, this worker "
            f"speaks {PROTOCOL}. Update one of them.")
        return 1

    if status.get("mode") != "remote":
        log("warning: this server is in local mode, so nothing will be handed out.")
        return 1

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Stop:
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
