# ------------------------------------------------------------------- the command


def check_argv(argv: list[str]) -> None:
    """
    Refuse a command line that is not the one this script agreed to run.

    The server dictating the flags is what keeps them in one tested place, and the price of
    that is being explicit about the trust involved: a Nextcloud that has been taken over
    could otherwise ask its workers to run anything. Two checks close that off — the
    program run is always this machine's yt-dlp, and no option may hand execution to
    something else — and neither can be got around by a cleverer job descriptor.
    """
    if not argv or argv[0] != "{ytdlp}":
        raise ValueError("the command does not start with the yt-dlp placeholder")

    for argument in argv[1:]:
        for flag in FORBIDDEN_FLAGS:
            if argument == flag or argument.startswith(flag + "="):
                raise ValueError(f"the command carries a forbidden option: {flag}")


def substitute(argv: list[str], tools: Tools, work_dir: str, cookie_file: str | None) -> list[str]:
    """Fill in the three or four paths only this machine knows."""
    replacements = {
        "{ytdlp}": tools.yt_dlp,
        "{ffmpeg}": tools.ffmpeg_dir,
        "{dir}": work_dir,
        "{cookies}": cookie_file or "",
    }

    filled = []
    for argument in argv:
        for placeholder, value in replacements.items():
            argument = argument.replace(placeholder, value)
        filled.append(argument)
    return filled


def child_environment(work_dir: str) -> dict:
    """
    The environment yt-dlp gets: small, and pointing at a directory that is about to be
    deleted.

    Anything the program decides to write beside itself — a cache, a .pyc — should land
    somewhere temporary rather than in the worker user's home, which may be shared, may be
    unwritable, and is not something an import should be leaving traces in.

    The proxy variables are the exception, and are passed through deliberately: a worker
    behind one needs it, and unlike the server this machine's route to the internet is the
    whole reason it is doing the job.
    """
    environment = {
        "PATH": os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin"),
        "HOME": work_dir,
        "XDG_CACHE_HOME": work_dir,
        "TMPDIR": work_dir,
        "LC_ALL": "C",
        "PYTHONDONTWRITEBYTECODE": "1",
    }
    for name in ("http_proxy", "https_proxy", "no_proxy", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"):
        if name in os.environ:
            environment[name] = os.environ[name]
    return environment


# ----------------------------------------------------------------------- running

_stopping = threading.Event()


def sleep_interruptibly(seconds: float) -> None:
    if _stopping.wait(seconds):
        raise Stop()


def parse_progress(line: str, prefix: str) -> float | None:
    """
    How far along a download is, from one line of yt-dlp's output.

    The template is the server's — it asks for `downloaded, estimate, total` — and both
    size fields are read because either can be `NA`: a progressive file knows its length up
    front, a fragmented one only has an estimate, and a small file can report `NA` for the
    estimate and a real number for the total. Preferring whichever is numeric is the
    difference between a progress bar and a division by zero.
    """
    if not line.startswith(prefix + ":"):
        return None

    fields = line[len(prefix) + 1:].split()
    if len(fields) < 3:
        return None

    def number(field: str) -> float | None:
        try:
            return float(field)
        except ValueError:
            return None

    downloaded = number(fields[0])
    total = number(fields[1]) or number(fields[2])
    if downloaded is None or total is None or total <= 0:
        return None

    return min(1.0, downloaded / total)


def run_capturing(argv: list[str], environment: dict, work_dir: str, timeout: int):
    """Run to completion, keeping the output. Used for the probe pass, which is quick."""
    try:
        done = subprocess.run(
            argv,
            cwd=work_dir,
            env=environment,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return done.returncode, done.stdout, done.stderr, False
    except subprocess.TimeoutExpired as expired:
        return 1, _text(expired.stdout), _text(expired.stderr), True


def _text(value) -> str:
    if value is None:
        return ""
    return value if isinstance(value, str) else value.decode("utf-8", "replace")


def run_download(argv, environment, work_dir, timeout, on_progress):
    """
    Run the download, watching it as it goes.

    Both pipes are drained by threads, which is not decoration: yt-dlp writes a progress
    line every fraction of a second and several kilobytes to stderr, and a full pipe stops
    the child dead. Reading one pipe in the main loop while the other fills is the classic
    way to deadlock a subprocess.

    The main loop waits on the queue with a short timeout rather than blocking on a read,
    so that `on_progress` is still called during the long quiet stretch when yt-dlp has
    finished downloading and ffmpeg is transcoding with nothing to say. That silence is
    exactly when a server left unheartbeaten would conclude this worker had died.
    """
    process = subprocess.Popen(
        argv,
        cwd=work_dir,
        env=environment,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
    )

    lines: queue.Queue = queue.Queue()
    errors: list[str] = []

    def pump_stdout() -> None:
        assert process.stdout is not None
        for line in process.stdout:
            lines.put(line.rstrip("\n"))
        lines.put(None)

    def pump_stderr() -> None:
        assert process.stderr is not None
        for line in process.stderr:
            errors.append(line.rstrip("\n"))

    threading.Thread(target=pump_stdout, daemon=True).start()
    threading.Thread(target=pump_stderr, daemon=True).start()

    stdout: list[str] = []
    deadline = time.monotonic() + timeout
    timed_out = False
    finished = False

    while not finished:
        if _stopping.is_set():
            terminate(process)
            raise Stop()

        if time.monotonic() > deadline:
            timed_out = True
            terminate(process)
            break

        try:
            line = lines.get(timeout=1.0)
        except queue.Empty:
            line = ""
        if line is None:
            finished = True
        elif line:
            stdout.append(line)

        # Called on every turn of the loop, including the empty ones. Whether it reports
        # anything is its own decision; what matters here is that it gets the chance.
        if on_progress(line or "", process) is False:
            terminate(process)
            raise LeaseLost()

    try:
        process.wait(timeout=10)
    except subprocess.TimeoutExpired:
        process.kill()

    code = process.returncode if process.returncode is not None else 1

    return code, "\n".join(stdout), "\n".join(errors), timed_out


def terminate(process) -> None:
    """Ask, then insist. yt-dlp cleans up partial files when it is asked politely."""
    try:
        process.terminate()
        process.wait(timeout=10)
    except Exception:
        try:
            process.kill()
        except Exception:
            pass


# -------------------------------------------------------------------- one import


class Worker:
    def __init__(self, api: Api, tools: Tools, cache: Cache, name: str, args) -> None:
        self.api = api
        self.tools = tools
        self.cache = cache
        self.name = name
        self.args = args
        self.job: dict | None = None

    # -- the loop ----------------------------------------------------------

    def run_forever(self) -> int:
        log(f"worker '{self.name}' ready — yt-dlp {self.tools.version()}, "
            f"ffmpeg in {self.tools.ffmpeg_dir}, "
            f"javascript {self.tools.js_spec or 'none (imports may fail)'}")
        log(f"cache: {self.cache.summary()}")

        idle_since = None
        while not _stopping.is_set():
            try:
                job = self.claim()
            except Stop:
                break
            except ApiError as error:
                if error.status == 409:
                    log("this server is not handing out imports (it is in local mode); waiting")
                    self._sleep(60)
                    continue
                if error.status in (401, 403):
                    log(f"refused: {error}. Check the account, the app password and the "
                        f"worker allow-list on the server.")
                    return 1
                log(f"could not ask for work: {error}")
                self._sleep(30)
                continue
            except Exception as error:  # noqa: BLE001 - the loop must survive anything
                log(f"could not ask for work: {error}")
                self._sleep(30)
                continue

            if job is None:
                if idle_since is None:
                    idle_since = time.monotonic()
                    debug("nothing waiting")
                self._sleep(self.args.poll_interval)
                continue

            idle_since = None
            try:
                self.handle(job)
            except Stop:
                break
            except Exception as error:  # noqa: BLE001
                log(f"job {job.get('importId')} ended badly: {error}")
                # Only worth reporting if the job is still ours. Anything that took the
                # lease away has already put a reason on the row.
                if self.job is not None:
                    self.report_failure(job, "download", code="unknown", stderr=str(error))

            if self.args.once:
                break

        # A job still in hand on the way out is given back rather than left to time out:
        # another worker can have it seconds from now, and whoever is waiting sees a queued
        # row instead of a stalled one.
        self.release_current()
        log("stopped")
        return 0

    def _sleep(self, seconds: float) -> None:
        sleep_interruptibly(seconds)

    # -- the API calls ------------------------------------------------------

    def claim(self) -> dict | None:
        answer = self.api.call(
            "POST",
            "/claim",
            body={"worker": self.name, "jsRuntime": self.tools.js_spec},
        )
        job = answer.get("job")
        if not job:
            return None

        if job.get("protocol", PROTOCOL) != PROTOCOL:
            log(f"warning: the server speaks protocol {job.get('protocol')} and this worker "
                f"speaks {PROTOCOL}. Update the worker script.")

        self.job = job
        log(f"job {job['importId']}: {job['url']}")
        return job

    def report_failure(self, job, stage, *, code="", exit_code=1, timed_out=False,
                       produced=False, cookies_used=False, stdout="", stderr="") -> None:
        # Said out loud, not only sent. The server turns this into a sentence for whoever
        # asked for the import, but somebody watching the worker's journal would otherwise
        # see a job start and then nothing at all — which is the same thing they would see
        # if it had hung.
        reason = code or ("timed out" if timed_out else f"exit {exit_code}")
        detail = next((line for line in reversed(stderr.splitlines()) if line.strip()), "")
        doing = "asking what the video is" if stage == "probe" else "downloading"
        log(f"job {job['importId']}: failed while {doing} — {reason}"
            + (f": {detail.strip()[:160]}" if detail else ""))

        try:
            self.api.call_with_retries(
                "POST",
                f"/jobs/{job['importId']}/fail",
                body={
                    "lease": job["lease"],
                    "stage": stage,
                    "code": code,
                    "exitCode": exit_code,
                    "timedOut": timed_out,
                    "producedFile": produced,
                    "cookiesUsed": cookies_used,
                    "jsRuntime": bool(self.tools.js_runtime),
                    # Tails only. The first lines of a yt-dlp failure are the download it
                    # was attempting; the last are why it stopped.
                    "stdout": stdout[-4000:],
                    "stderr": stderr[-8000:],
                },
            )
        except Exception as error:  # noqa: BLE001
            log(f"could not report the failure of job {job['importId']}: {error}")
        finally:
            self.job = None

    def release_current(self) -> None:
        job = self.job
        if job is None:
            return
        self.job = None
        try:
            self.api.call("POST", f"/jobs/{job['importId']}/release", body={"lease": job["lease"]})
            log(f"job {job['importId']} given back to the queue")
        except Exception as error:  # noqa: BLE001
            log(f"could not give job {job['importId']} back: {error}")

    # -- doing the work ------------------------------------------------------

    def handle(self, job: dict) -> None:
        work_dir = tempfile.mkdtemp(prefix="music-radio-", dir=self.args.work_dir or None)
        try:
            self.process(job, work_dir)
        except ApiError as error:
            if error.status not in (403, 404):
                raise
            raise LeaseLost() from None
        except LeaseLost:
            # Cancelled, taken back after a silence, or the channel was deleted. The server
            # already knows what it thinks; there is nothing to report and nothing to undo.
            log(f"job {job['importId']} is no longer ours")
            self.job = None
        finally:
            shutil.rmtree(work_dir, ignore_errors=True)

    def process(self, job: dict, work_dir: str) -> None:
        try:
            check_argv(job["probeArgv"])
            check_argv(job["downloadArgv"])
        except ValueError as error:
            # Loud, and the job goes back rather than being failed: this is a disagreement
            # about what the server is allowed to ask for, not a bad video, and somebody
            # needs to look at it.
            log(f"refusing job {job['importId']}: {error}")
            self.release_current()
            return

        if self.serve_from_cache(job):
            return

        environment = child_environment(work_dir)
        cookie_file = self.fetch_cookies(job, work_dir)

        # --- what is this? -------------------------------------------------
        argv = substitute(job["probeArgv"], self.tools, work_dir, cookie_file)
        debug(f"probe: {' '.join(argv)}")
        code, stdout, stderr, timed_out = run_capturing(
            argv, environment, work_dir, job["probeTimeoutSeconds"]
        )

        if code != 0 or timed_out:
            self.return_cookies(job, cookie_file)
            self.report_failure(job, "probe", exit_code=code, timed_out=timed_out,
                                cookies_used=bool(cookie_file), stdout=stdout, stderr=stderr)
            return

        try:
            metadata = json.loads(stdout)
        except json.JSONDecodeError:
            self.report_failure(job, "probe", code="unknown", exit_code=code,
                                cookies_used=bool(cookie_file), stdout=stdout, stderr=stderr)
            return

        answer = self.api.call_with_retries(
            "POST",
            f"/jobs/{job['importId']}/metadata",
            body={"lease": job["lease"], "metadata": self.trim_metadata(metadata)},
        )
        if not answer.get("proceed"):
            # The server has refused it — too long, a live stream, an age gate — and has
            # already written that on the row. Nothing more to say.
            log(f"job {job['importId']} refused by the server: {answer.get('code')}")
            self.job = None
            return

        title = metadata.get("title") or job["videoId"]
        log(f"job {job['importId']}: fetching “{title}”")

        # --- fetch it -------------------------------------------------------
        argv = substitute(job["downloadArgv"], self.tools, work_dir, cookie_file)
        debug(f"download: {' '.join(argv)}")

        beat = Heartbeat(self.api, job, job["heartbeatSeconds"], job["progressPrefix"])
        code, stdout, stderr, timed_out = run_download(
            argv, environment, work_dir, job["downloadTimeoutSeconds"], beat.saw
        )

        self.return_cookies(job, cookie_file)

        produced = self.produced_file(work_dir, job["outputStem"])
        if code != 0 or timed_out or produced is None:
            self.report_failure(job, "download", exit_code=code, timed_out=timed_out,
                                produced=produced is not None, cookies_used=bool(cookie_file),
                                stdout=stdout, stderr=stderr)
            return

        # --- keep a copy ------------------------------------------------------
        # Before the upload rather than after it, so a file that took a minute to produce
        # survives even if handing it back fails. A cookie-authenticated run is never
        # stored — see Cache for why that is not merely caution.
        if not cookie_file:
            self.cache.put(
                job["videoId"],
                produced,
                self.trim_metadata(metadata),
                audio_fingerprint(job["downloadArgv"]),
            )

        # --- hand it back ----------------------------------------------------
        self.upload(job, produced, metadata)

    def serve_from_cache(self, job: dict) -> bool:
        """
        Hand back a copy already on this machine, if there is one.

        The server is still asked. It records the title and duration from the metadata and
        applies its own rules to it — the length limit may have been lowered since this was
        fetched, and it is the server's business either way, not this script's. What is
        skipped is the two yt-dlp runs, which is the whole cost of an import.

        Cookie jobs never look, for the reason in {@see Cache}: what YouTube served to one
        signed-in account is not what it would serve to an anonymous request.
        """
        if job.get("cookies") or not self.cache.enabled:
            return False

        found = self.cache.get(job["videoId"], audio_fingerprint(job["downloadArgv"]))
        if found is None:
            return False

        path, metadata = found

        answer = self.api.call_with_retries(
            "POST",
            f"/jobs/{job['importId']}/metadata",
            body={"lease": job["lease"], "metadata": metadata},
        )
        if not answer.get("proceed"):
            log(f"job {job['importId']} refused by the server: {answer.get('code')}")
            self.job = None
            return True

        log(f"job {job['importId']}: already on this machine — “{metadata.get('title') or job['videoId']}”")
        # Uploaded straight out of the cache. Nothing here deletes it: the copy is the point,
        # and eviction is the only thing that removes one.
        self.upload(job, path, metadata)

        return True

    def trim_metadata(self, metadata: dict) -> dict:
        """
        Send the fields the server actually reads, and not the rest.

        `--dump-single-json` produces a document of a few hundred kilobytes, most of it
        format lists, thumbnails and subtitle URLs. The server wants five values out of it.
        """
        wanted = (
            "title", "duration", "is_live", "live_status", "availability",
            "age_limit", "uploader", "channel", "extractor",
        )
        return {key: metadata[key] for key in wanted if key in metadata}

    def produced_file(self, work_dir: str, stem: str) -> str | None:
        """
        The single audio file the download should have left behind.

        More than one match means something unexpected happened and it is not clear which
        file is the track, so nothing is guessed at.
        """
        candidates = [
            path
            for path in glob.glob(os.path.join(work_dir, stem + ".*"))
            if os.path.isfile(path)
            and not path.endswith(".info.json")
            and not path.endswith(".part")
        ]
        return candidates[0] if len(candidates) == 1 else None

    def upload(self, job: dict, path: str, metadata: dict) -> None:
        size = os.path.getsize(path)
        if size > job["maxUploadBytes"]:
            self.report_failure(job, "download", code="too_large", exit_code=0, produced=True)
            return

        duration = metadata.get("duration")
        duration_ms = int(float(duration) * 1000) if isinstance(duration, (int, float)) else 0

        log(f"job {job['importId']}: uploading {size / 1024 / 1024:.1f} MB")

        with open(path, "rb") as audio:
            try:
                answer = self.api.call(
                    "PUT",
                    f"/jobs/{job['importId']}/audio",
                    params={"lease": job["lease"], "durationMs": duration_ms},
                    data=audio,
                    length=size,
                    content_type="audio/mpeg",
                    # Generous: this is a whole file over whatever connection the worker
                    # has, and the server writes it into somebody's storage at the far end.
                    timeout=600,
                )
            except ApiError as error:
                # 403 here is the good kind of failure. The lease is cleared the moment a
                # job is filed, so a retried upload — the one whose answer was lost on the
                # way back — is refused rather than filed twice.
                if error.status in (403, 404):
                    log(f"job {job['importId']}: the server has already finished with it")
                    self.job = None
                    return
                log(f"job {job['importId']}: the server refused the upload ({error})")
                self.job = None
                return

        log(f"job {job['importId']}: done — track {answer.get('trackId')}")
        self.job = None

    # -- cookies -------------------------------------------------------------

    def fetch_cookies(self, job: dict, work_dir: str) -> str | None:
        """
        Borrow the channel owner's YouTube cookies, if the server lends them at all.

        Off unless an administrator switched it on. What arrives is somebody's session, so
        it is written 0600 into a directory that is deleted when the job ends, and it is
        never logged.
        """
        if not job.get("cookies"):
            return None

        try:
            answer = self.api.call("GET", f"/jobs/{job['importId']}/cookies",
                                   params={"lease": job["lease"]})
        except ApiError as error:
            log(f"job {job['importId']}: could not fetch cookies ({error}); going without")
            return None

        jar = answer.get("cookies")
        if not jar:
            return None

        path = os.path.join(work_dir, "cookies.txt")
        # Created empty and locked down before anything is written to it: writing first and
        # chmod'ing after leaves the cookies readable for the width of that gap.
        handle = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(handle, "w") as file:
            file.write(jar)

        debug("using the channel owner's cookies")
        return path

    def return_cookies(self, job: dict, cookie_file: str | None) -> None:
        """
        Give back the jar as yt-dlp left it.

        YouTube rotates session cookies and yt-dlp writes the rotated set out. Without this
        the stored copy would be the one that was pasted, going staler every run — and it
        would go stale fastest on exactly the channels whose imports are struggling.

        Sent after failures too, for that reason.
        """
        if not cookie_file or not os.path.isfile(cookie_file):
            return

        try:
            with open(cookie_file, encoding="utf-8", errors="replace") as file:
                jar = file.read()
        except OSError:
            return

        if not jar.strip():
            return

        try:
            self.api.call("POST", f"/jobs/{job['importId']}/cookies",
                          body={"lease": job["lease"], "cookies": jar})
        except Exception as error:  # noqa: BLE001
            debug(f"could not return the cookie jar: {error}")


class Heartbeat:
    """
    Telling the server this job is still alive, and hearing back that it is not wanted.

    The answer is the only way a cancellation reaches this machine: whoever pressed the
    button is talking to the Nextcloud, not to us. So the reply is read every time, and a
    false return aborts the download.
    """

    # How many missed beats a download survives. Ten at fifteen seconds is well over two
    # minutes of network trouble — longer than the lease, so the server will have given the
    # job to somebody else by then anyway.
    TOLERATED_FAILURES = 10

    def __init__(self, api: Api, job: dict, interval: int, prefix: str) -> None:
        self.api = api
        self.job = job
        self.interval = max(2, interval)
        self.prefix = prefix
        self.fraction = 0.0
        self.last = 0.0
        self.failures = 0

    def saw(self, line: str, process) -> bool:
        fraction = parse_progress(line, self.prefix)
        if fraction is not None:
            self.fraction = fraction

        now = time.monotonic()
        if now - self.last < self.interval:
            return True
        self.last = now

        # Once the bytes are in, yt-dlp hands over to ffmpeg and says nothing for a while.
        # Reported as its own phase so the interface can show something honest instead of a
        # bar stuck at 100%.
        phase = "converting" if self.fraction >= 1.0 else "downloading"

        try:
            answer = self.api.call(
                "POST",
                f"/jobs/{self.job['importId']}/progress",
                body={
                    "lease": self.job["lease"],
                    "phase": phase,
                    "progress": int(self.fraction * 100),
                },
            )
        except ApiError as error:
            if error.status in (403, 404):
                # The lease is gone: cancelled, taken back after a silence, or the channel
                # was deleted. Either way this download is no longer wanted.
                return False
            self.failures += 1
            return self.failures <= self.TOLERATED_FAILURES
        except Exception:  # noqa: BLE001
            # A dropped connection is not a reason to throw away a download that is going
            # perfectly well. The lease outlives several missed beats, and the job is given
            # back automatically if the network never comes back at all.
            self.failures += 1
            return self.failures <= self.TOLERATED_FAILURES

        self.failures = 0

        return not answer.get("cancelled", False)


