    print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}", flush=True)


def debug(message: str) -> None:
    if _verbose:
        log(f"  {message}")


# --------------------------------------------------------------------------- api


class Api:
    """
    The Nextcloud end of the conversation.

    Authentication is HTTP Basic with an **app password**, which is how every non-browser
    Nextcloud client signs in: the server checks it with the same code that checks
    everything else, so brute-force protection and revocation behave the way an
    administrator already expects. The header is sent on every request rather than waiting
    to be challenged — urllib's authentication handlers only react to a 401, which would
    double every call and, worse, log a failed sign-in each time.

    `OCS-APIRequest: true` is not decoration. It is what marks this as an API client rather
    than a browser, and it is what exempts the call from a CSRF token there is no session
    to get one from.
    """

    def __init__(self, base: str, user: str, password: str, timeout: int = 30) -> None:
        self.base = base.rstrip("/") + "/ocs/v2.php/apps/music_radio/api/v1/worker"
        self.timeout = timeout
        credentials = base64.b64encode(f"{user}:{password}".encode()).decode()
        self.headers = {
            "Authorization": f"Basic {credentials}",
            "OCS-APIRequest": "true",
            "Accept": "application/json",
            "User-Agent": "music-radio-worker/1.0",
        }

    def call(
        self,
        method: str,
        path: str,
        *,
        params: dict | None = None,
        body: dict | None = None,
        data=None,
        length: int | None = None,
        content_type: str | None = None,
        timeout: int | None = None,
    ) -> dict:
        query = dict(params or {})
        # OCS answers XML unless asked otherwise, and every client asks in the URL.
        query["format"] = "json"
        url = f"{self.base}{path}?{urllib.parse.urlencode(query)}"

        headers = dict(self.headers)
        payload = data
        if body is not None:
            payload = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        if content_type is not None:
            headers["Content-Type"] = content_type
        if length is not None:
            # Set explicitly so http.client streams the body in blocks instead of reading
            # a whole MP3 into memory to measure it.
            headers["Content-Length"] = str(length)

        request = urllib.request.Request(url, data=payload, headers=headers, method=method)

        try:
            with urllib.request.urlopen(request, timeout=timeout or self.timeout) as response:
                return self._unwrap(response.read())
        except urllib.error.HTTPError as error:
            raw = error.read().decode("utf-8", "replace")
            code = ""
            try:
                code = str(self._unwrap(raw.encode()).get("error", ""))
            except Exception:
                pass
            raise ApiError(error.code, code, raw[:500]) from None

    @staticmethod
    def _unwrap(raw: bytes) -> dict:
        """Take the payload out of the OCS envelope."""
        if not raw:
            return {}
        document = json.loads(raw.decode("utf-8", "replace"))
        data = document.get("ocs", {}).get("data", {})
        return data if isinstance(data, dict) else {"data": data}

    def call_with_retries(self, method: str, path: str, **kwargs) -> dict:
        """
        The same, for calls where a dropped connection is not a reason to abandon a job.

        Only the transport is retried. An answer from the server — including a refusal — is
        the answer, and asking again would not change it.
        """
        for attempt, delay in enumerate((*RETRY_DELAYS, None)):
            try:
                return self.call(method, path, **kwargs)
            except (urllib.error.URLError, socket.timeout, ConnectionError) as error:
                if delay is None:
                    raise
                debug(f"network error ({error}); retrying in {delay}s")
                sleep_interruptibly(delay)
        raise AssertionError("unreachable")


# ------------------------------------------------------------------- local tools


class Tools:
    """What this machine has to offer, worked out once at start-up."""

    def __init__(self, yt_dlp: str, ffmpeg_dir: str, js_runtime: str | None) -> None:
        self.yt_dlp = yt_dlp
        self.ffmpeg_dir = ffmpeg_dir
        self.js_runtime = js_runtime

    @property
    def js_spec(self) -> str:
        """What `--js-runtimes` wants, and what the server is told: `name:/path`."""
        if not self.js_runtime:
            return ""
        return f"{os.path.basename(self.js_runtime)}:{self.js_runtime}"

    def version(self) -> str:
        if not self.yt_dlp:
            return "not installed"
        try:
            done = subprocess.run(
                [self.yt_dlp, "--version"], capture_output=True, text=True, timeout=30
            )
            return done.stdout.strip().splitlines()[0] if done.stdout.strip() else "?"
        except Exception:
            return "?"


def discover_tools(args, required: bool = True) -> Tools:
    """
    Find yt-dlp, ffmpeg and something to run YouTube's JavaScript in.

    yt-dlp is looked for in three places, in the order the Nextcloud app uses for exactly
    the same reasons: a path somebody set explicitly, then the copy `install` and `update`
    manage, then whatever is on PATH. The managed copy comes before the system one on
    purpose — a distribution's yt-dlp is frequently a year old, which for this program means
    reliably broken, while a copy this script installed is one it can refresh in a quarter
    of an hour.

    The JavaScript runtime is the one people are surprised by. YouTube signs its media URLs
    with JavaScript that yt-dlp has to execute, and yt-dlp enables only `deno` by default —
    so a machine with node and no deno looks to it like a machine with nothing. Finding one
    here and naming it on the command line is what makes the difference between imports
    that work and imports that fail at random.

    @param required whether a missing tool should stop the program. False for `install` and
                    `update`, whose whole purpose is to be run on a machine that has not got
                    them yet.
    """
    yt_dlp = ""
    for candidate in [args.yt_dlp, *managed_ytdlp_paths(), shutil.which("yt-dlp") or ""]:
        if candidate and os.access(candidate, os.X_OK) and os.path.isfile(candidate):
            yt_dlp = candidate
            break
    if not yt_dlp and required:
        die("yt-dlp was not found. Install it with `music-radio-worker install`, "
            "or give --yt-dlp /path/to/yt-dlp.")

    ffmpeg = args.ffmpeg or shutil.which("ffmpeg")
    if (not ffmpeg or not os.access(ffmpeg, os.X_OK)) and required:
        die("ffmpeg was not found. Install it, or give --ffmpeg /path/to/ffmpeg.")

    ffmpeg_dir = ""
    if ffmpeg and os.access(ffmpeg, os.X_OK):
        ffmpeg_dir = os.path.dirname(os.path.abspath(ffmpeg))
        # yt-dlp's audio postprocessor uses both, and finding only ffmpeg turns a clear
        # complaint now into a confusing mid-download failure later.
        if not os.access(os.path.join(ffmpeg_dir, "ffprobe"), os.X_OK):
            if required:
                die(f"ffprobe was not found next to ffmpeg in {ffmpeg_dir}. Both are needed.")
            ffmpeg_dir = ""

    runtime = args.js_runtime
    if runtime and not os.access(runtime, os.X_OK):
        if required:
            die(f"No JavaScript runtime can be run at {runtime}.")
        runtime = ""
    if not runtime:
        for name in JS_RUNTIMES:
            found = shutil.which(name)
            if found:
                runtime = found
                break

    return Tools(
        os.path.abspath(yt_dlp) if yt_dlp else "",
        ffmpeg_dir,
        os.path.abspath(runtime) if runtime else None,
    )


# --------------------------------------------------------------------- the cache


class Cache:
    """
    Finished audio, kept between jobs.

    The same video really does get imported more than once — onto a second channel, after a
    track was deleted, or because a job was retried — and each of those is otherwise a fresh
    download and a fresh transcode. A hit here turns a job that takes half a minute into one
    that takes as long as the upload.

    **What is stored.** One MP3 per video id, with a small JSON sidecar holding the metadata
    the server is sent (title, duration, availability) and a fingerprint of the audio
    settings the file was produced with. The fingerprint is what keeps a stale entry from
    being served if the server ever asks for a different format: it is taken from the
    `--audio-format` and `--audio-quality` the server put on the command line, so a change
    there invalidates the cache without anybody having to remember to.

    **What is deliberately not stored.** Anything fetched with the channel owner's cookies.
    A cached copy would be reused for somebody else's import, and YouTube's answer to a
    signed-in request is not the same as its answer to an anonymous one — a members-only
    track fetched for the account that has access could otherwise turn up on a channel whose
    owner has none. Those jobs skip the cache in both directions.

    **It is a cache, not a library.** Entries are evicted, least-recently-used first, to stay
    under a byte budget, and it is safe to delete the whole directory at any time. Nothing
    depends on an entry being there.
    """

    #: Video ids as YouTube writes them. The id arrives from the server, which has already
    #: reduced it to this shape — checked again because it is about to become a filename.
    SAFE_ID = re.compile(r"^[A-Za-z0-9_-]{1,32}$")

    def __init__(self, directory: str | None, max_bytes: int) -> None:
        self.max_bytes = max_bytes
        self.directory = directory if max_bytes > 0 else None

        if self.directory is None:
            return

        try:
            os.makedirs(self.directory, mode=0o700, exist_ok=True)
        except OSError as error:
            # Not fatal, and deliberately so: a worker that cannot write a cache is a worker
            # that does slightly more work, not a broken one.
            #
            # It is worth naming the cause, though. This warning was seen in the wild and
            # read as a permissions mistake on the machine, when what it meant was that the
            # unit had no CacheDirectory= and the script had therefore fallen back to a home
            # directory that ProtectHome= seals off. Nothing about the message said so, and
            # the cost — every video downloaded twice — is invisible from anywhere else.
            log(f"warning: no cache at {self.directory} ({error}); every import will be downloaded")
            if os.environ.get("INVOCATION_ID") and not os.environ.get("CACHE_DIRECTORY"):
                log("  this service has no CacheDirectory=; re-run "
                    "'music-radio-worker install' to rewrite the unit")
            self.directory = None

    @property
    def enabled(self) -> bool:
        return self.directory is not None

    # -- reading ------------------------------------------------------------

    def get(self, video_id: str, fingerprint: str) -> tuple[str, dict] | None:
        """The stored audio and its metadata, if this exact thing is here."""
        paths = self._paths(video_id)
        if paths is None:
            return None
        audio, sidecar = paths

        try:
            with open(sidecar, encoding="utf-8") as file:
                stored = json.load(file)
            size = os.path.getsize(audio)
        except (OSError, json.JSONDecodeError):
            return None

        if size <= 0 or stored.get("fingerprint") != fingerprint:
            return None

        # Least-recently-*used*, so a video imported every week outlives one fetched once
        # and forgotten. Nothing else reads these timestamps.
        now = time.time()
        for path in (audio, sidecar):
            try:
                os.utime(path, (now, now))
            except OSError:
                pass

        return audio, stored.get("metadata", {})

    # -- writing ------------------------------------------------------------

    def put(self, video_id: str, source: str, metadata: dict, fingerprint: str) -> None:
        """
        Keep a copy of a file that has just been produced.

        Best effort throughout. A cache that cannot be written is not a reason to fail an
        import that has otherwise worked.
        """
        paths = self._paths(video_id)
        if paths is None:
            return
        audio, sidecar = paths

        try:
            size = os.path.getsize(source)
        except OSError:
            return

        # One file that would fill the whole budget is not worth evicting everything else
        # for; the next hit would be its own eviction.
        if size > self.max_bytes:
            debug(f"not caching {video_id}: {size} bytes is larger than the whole cache")
            return

        def copy(handle) -> None:
            with open(source, "rb") as original:
                shutil.copyfileobj(original, handle)

        try:
            # Written under another name and moved into place, because a worker killed
            # mid-copy would otherwise leave a truncated MP3 that a later job would upload
            # as somebody's track. os.replace is atomic within a directory.
            self._write(audio, copy)
            self._write(
                sidecar,
                lambda handle: handle.write(json.dumps({
                    "fingerprint": fingerprint,
                    "metadata": metadata,
                }).encode()),
            )
        except OSError as error:
            debug(f"could not cache {video_id}: {error}")
            self._remove(video_id)
            return

        self._evict()

    def _write(self, path: str, fill) -> None:
        temporary = path + f".{os.getpid()}.part"
        try:
            handle = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(handle, "wb") as file:
                fill(file)
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)

    # -- housekeeping -------------------------------------------------------

    def _evict(self) -> None:
        """Drop the least recently used entries until the budget is met."""
        entries = self._entries()
        total = sum(size for _, size, _ in entries)
        if total <= self.max_bytes:
            return

        for video_id, size, _ in sorted(entries, key=lambda entry: entry[2]):
            if total <= self.max_bytes:
                break
            self._remove(video_id)
            total -= size
            debug(f"evicted {video_id} from the cache")

    def _entries(self) -> list[tuple[str, int, float]]:
        """Every stored video as (id, bytes on disk, last used)."""
        if self.directory is None:
            return []

        found = []
        for name in os.listdir(self.directory):
            if not name.endswith(".mp3"):
                continue
            video_id = name[:-4]
            paths = self._paths(video_id)
            if paths is None:
                continue
            try:
                size = sum(os.path.getsize(path) for path in paths if os.path.exists(path))
                used = os.path.getmtime(paths[0])
            except OSError:
                continue
            found.append((video_id, size, used))

        return found

    def _remove(self, video_id: str) -> None:
        paths = self._paths(video_id)
        if paths is None:
            return
        for path in paths:
            try:
                os.unlink(path)
            except OSError:
                pass

    def _paths(self, video_id: str) -> tuple[str, str] | None:
        if self.directory is None or not self.SAFE_ID.match(video_id):
            return None

        stem = os.path.join(self.directory, video_id)

        return stem + ".mp3", stem + ".json"

    def summary(self) -> str:
        if self.directory is None:
            return "off"

        entries = self._entries()
        used = sum(size for _, size, _ in entries) / 1024 / 1024

        return (f"{self.directory} — {len(entries)} tracks, {used:.0f} MB "
                f"of {self.max_bytes / 1024 / 1024:.0f} MB")


def systemd_directory(variable: str) -> str:
    """
    A directory systemd made for this service, if it made one.

    `RuntimeDirectory=` and `CacheDirectory=` in the unit each create a directory owned by
    the service account and name it in the environment — already including the unit's own
    subdirectory, so nothing is appended to what comes back. The value is colon-separated
    when a unit asks for several; ours ask for one apiece.

    Reading these rather than writing the paths into worker.env is deliberate: the unit is
    what decides where a hardened service may write, so the unit should be the one place
    that says. It also means an existing installation is fixed by the new script alone,
    with no need to re-run `install`.
    """
    value = os.environ.get(variable, "")

    return value.split(":")[0] if value else ""


def default_cache_dir() -> str:
    """
    Where a cache lives when nobody says otherwise.

    `CacheDirectory=` first, because under the system unit it is the only writable place
    that outlives a job: `ProtectHome=true` seals off home directories, and the service
    account has not got one anyway. Without this the cache silently fell back to
    `~/.cache`, was refused, and every import downloaded again — which is a slow, expensive
    failure that looks exactly like a working worker.

    Otherwise the XDG location, which is what somebody running this from a shell expects.
    """
    runtime = systemd_directory("CACHE_DIRECTORY")
    if runtime:
        return runtime

    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")

    return os.path.join(base, "music-radio-worker")


def default_work_dir() -> str:
    """
    Where downloads land, when nobody says otherwise.

    `RuntimeDirectory=` for the same reason, and empty when there is none — which leaves
    {@see tempfile} to pick, as it did before.
    """
    return systemd_directory("RUNTIME_DIRECTORY")


def audio_fingerprint(argv: list[str]) -> str:
    """
    What the server asked the audio to be, as a short string.

    Only the settings that decide what the produced file *is* — not the limits, the paths or
    the cookie flags, which change the run without changing its output. Stored beside a
    cached file so that a change of format on the server retires the old entries by itself.
    """
    settings = []
    for flag in ("--audio-format", "--audio-quality"):
        if flag in argv:
            settings.append(argv[argv.index(flag) + 1])

    return "/".join(settings) or "unknown"


# ------------------------------------------------------------------ the machine


class Layout:
    """
    Every path this script owns, in one place.

    Two arrangements, chosen by whether the person running `install` is root. A machine with
    an administrator gets the ordinary system locations and a service account; somebody
    setting a worker up on a NAS they log into as themselves gets the XDG ones and a user
    unit. Nothing else in the script has to know which happened.
    """

    SERVICE_USER = "music-radio"

    def __init__(self, root: bool) -> None:
        self.root = root

        if root:
            self.script = "/usr/local/bin/music-radio-worker"
            self.config_dir = "/etc/music-radio"
            self.state_dir = "/var/lib/music-radio-worker"
            self.unit_dir = "/etc/systemd/system"
            self.service_user: str | None = self.SERVICE_USER
            self.wanted_by = "multi-user.target"
        else:
            home = os.path.expanduser("~")
            config = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
            data = os.environ.get("XDG_DATA_HOME") or os.path.join(home, ".local", "share")

            self.script = os.path.join(home, ".local", "bin", "music-radio-worker")
            self.config_dir = os.path.join(config, "music-radio-worker")
            self.state_dir = os.path.join(data, "music-radio-worker")
            self.unit_dir = os.path.join(config, "systemd", "user")
            # A user unit runs as the person who owns it; naming an account would be an
            # error rather than a restriction.
            self.service_user = None
            self.wanted_by = "default.target"

    @property
    def env_file(self) -> str:
        return os.path.join(self.config_dir, "worker.env")

    @property
    def password_file(self) -> str:
        return os.path.join(self.config_dir, "app-password")

    @property
    def yt_dlp(self) -> str:
        return os.path.join(self.state_dir, "bin", "yt-dlp")


def managed_ytdlp_paths() -> list[str]:
    """
    Where an installed copy of yt-dlp might be, whoever is asking.

    Both layouts, always — and that is the point. The worker runs as the service account,
    which has neither the home directory the user layout would look in nor any reason to
    know that root installed the copy it is about to run.
    """
    return [Layout(root=True).yt_dlp, Layout(root=False).yt_dlp]


class Packages:
    """
    What to tell somebody to install, in the words their system uses.

    Prints, never runs. Installing system packages is a root-level change to a machine, and
    a script that does it on its own initiative is a script that has decided something that
    was not its to decide — the more so on the two distributions where ffmpeg needs a
    third-party repository enabled first, which no amount of `install -y` can arrange.
    """

    #: binary, install command, ffmpeg package, JavaScript package, anything else to say
    MANAGERS = (
        ("apt-get", "apt-get install -y", "ffmpeg", "nodejs", ""),
        ("dnf", "dnf install -y", "ffmpeg", "nodejs",
         "ffmpeg comes from RPM Fusion on this distribution; enable it first."),
        ("yum", "yum install -y", "ffmpeg", "nodejs",
         "ffmpeg comes from RPM Fusion on this distribution; enable it first."),
        ("zypper", "zypper install -y", "ffmpeg", "nodejs",
         "ffmpeg comes from Packman on openSUSE; add that repository first."),
        ("apk", "apk add", "ffmpeg", "nodejs", ""),
        ("pacman", "pacman -S --noconfirm", "ffmpeg", "nodejs", ""),
        ("brew", "brew install", "ffmpeg", "node", ""),
    )

    def __init__(self) -> None:
        self.manager = None
        for entry in self.MANAGERS:
            if shutil.which(entry[0]):
                self.manager = entry
                break

    def advise(self, need_ffmpeg: bool, need_js: bool) -> None:
        """Say what is missing and exactly how to get it."""
        if not need_ffmpeg and not need_js:
            return

        wanted = []
        if need_ffmpeg:
            wanted.append("ffmpeg (with ffprobe)")
        if need_js:
            wanted.append("a JavaScript runtime — YouTube signs its audio links with "
                          "JavaScript that yt-dlp has to run")

        log(f"missing: {', and '.join(wanted)}")

        if self.manager is None:
            log("  install them with this system's package manager.")
            return

        _, command, ffmpeg_package, js_package, note = self.manager
        packages = ([ffmpeg_package] if need_ffmpeg else []) + ([js_package] if need_js else [])
        prefix = "" if os.geteuid() == 0 else "sudo "
        log(f"  {prefix}{command} {' '.join(packages)}")
        if note:
            log(f"  {note}")


class Systemd:
    """
    Writing units and telling systemd about them.

    Absent on purpose in a container, which is both a real way to run this and how it gets
    tested — so everything here degrades to saying what it would have done rather than
    failing.
    """

    def __init__(self, layout: Layout, dry_run: bool) -> None:
        self.layout = layout
        self.dry_run = dry_run
        # `systemctl` being on PATH is not the question — a Debian container has it and no
        # systemd behind it, which is exactly the case this has to get right. /run/systemd/
        # system is the canonical "systemd is the init system here" test, and it is the one
        # systemd's own tooling uses.
        self.available = bool(shutil.which("systemctl")) and os.path.isdir("/run/systemd/system")

    def user_flag(self) -> list[str]:
        return [] if self.layout.root else ["--user"]

    def write(self, name: str, body: str) -> None:
        path = os.path.join(self.layout.unit_dir, name)
        if self.dry_run:
            log(f"  would write {path}")
            return
        os.makedirs(self.layout.unit_dir, exist_ok=True)
        with open(path, "w", encoding="utf-8") as file:
            file.write(body)
        os.chmod(path, 0o644)
        log(f"  wrote {path}")

    def run(self, *arguments: str) -> bool:
        command = ["systemctl", *self.user_flag(), *arguments]
        if self.dry_run:
            log(f"  would run {' '.join(command)}")
            return True
        try:
            done = subprocess.run(command, capture_output=True, text=True, timeout=60)
        except Exception as error:  # noqa: BLE001
            log(f"  {' '.join(command)} failed: {error}")
            return False
        if done.returncode != 0:
            log(f"  {' '.join(command)} failed: {done.stderr.strip() or done.stdout.strip()}")
            return False
        return True

    def is_active(self, unit: str) -> bool:
        if not self.available:
            return False
        try:
            done = subprocess.run(["systemctl", *self.user_flag(), "is-active", "--quiet", unit],
                                  capture_output=True, timeout=30)
            return done.returncode == 0
        except Exception:  # noqa: BLE001
            return False


# ------------------------------------------------------------------ the download


class YtDlp:
    """
    Fetching yt-dlp, the same way the Nextcloud app does it for a server.

    This is a port of `lib/Service/YtDlpInstaller.php`, and deliberately a faithful one —
    the asset matrix and the checksum handling are the parts that took a while to get right,
    and two implementations that disagree about which build suits a machine would be worse
    than one.

    **On the choice of asset.** The obvious `yt-dlp_linux` is a ~38 MB PyInstaller bundle,
    one per architecture and libc, and picking the wrong one produces a file that exists, is
    executable, and cannot run. The plain `yt-dlp` asset is a ~3 MB zipimport archive with a
    `#!/usr/bin/env python3` shebang: the same program, any CPU, any libc, a thirteenth of
    the download. It is preferred wherever python3 will run it — which on a machine running
    *this script* is always, so in practice the matrix below is a fallback for the
    impossible case.

    **On the checksum.** It comes from the same host over the same TLS connection as the
    binary, so it is not an independent signature — GitHub and TLS remain the trust anchor.
    What it catches is a truncated transfer and a mismatch between the file asked for and
    the file received, both of which would otherwise fail confusingly much later.
    """

    RELEASE_BASE = "https://github.com/yt-dlp/yt-dlp/releases/latest/download/"
    CHECKSUMS = RELEASE_BASE + "SHA2-256SUMS"
    MIN_PYTHON = (3, 9)
    TIMEOUT = 300

    @staticmethod
    def asset_for(system: str, machine: str, musl: bool, python_ok: bool) -> str | None:
        """Which release asset suits this machine. Pure, so the whole matrix is checkable."""
        if python_ok:
            return "yt-dlp"

        if system == "Darwin":
            return "yt-dlp_macos"
        if system != "Linux":
            # Windows builds exist; nothing about this script has ever been run there and
            # claiming support without having tried it would be a lie.
            return None

        machine = machine.lower()
        if machine in ("x86_64", "amd64"):
            return "yt-dlp_musllinux" if musl else "yt-dlp_linux"
        if machine in ("aarch64", "arm64"):
            return "yt-dlp_musllinux_aarch64" if musl else "yt-dlp_linux_aarch64"

        # Published only as a zip, which would need unpacking; python is the better answer
        # on a 32-bit ARM box anyway.
        return None

    @classmethod
    def asset_here(cls) -> str | None:
        import platform

        # This script is running, so python3 is present by definition; the version is the
        # only open question.
        python_ok = sys.version_info >= cls.MIN_PYTHON
        musl = bool(glob.glob("/lib/ld-musl-*"))

        return cls.asset_for(platform.system(), platform.machine(), musl, python_ok)

    @classmethod
    def published_checksum(cls, asset: str) -> str | None:
        """
        The checksum published beside the current release.

        Fetched on its own, and that is what makes a fifteen-minute update timer reasonable:
        a few kilobytes of text answers "is there anything new" without pulling the binary.
        """
        try:
            sums = fetch(cls.CHECKSUMS, timeout=60).decode("utf-8", "replace")
        except Exception as error:  # noqa: BLE001
            log(f"could not fetch the yt-dlp checksums: {error}")
            return None

        for line in sums.splitlines():
            fields = line.split()
            if len(fields) >= 2 and os.path.basename(fields[1]) == asset:
                return fields[0].lower()

        return None

    @classmethod
    def install(cls, target: str, expected: str | None = None) -> tuple[str, str] | None:
        """
        Download, verify, prove it runs, and move it into place.

        @return (version, asset), or None when anything went wrong — said out loud first.
        """
        asset = cls.asset_here()
        if asset is None:
            import platform
            log(f"no yt-dlp build is published for {platform.system()}/{platform.machine()}. "
                f"Install yt-dlp yourself and point at it with --yt-dlp.")
            return None

        checksum = expected if expected is not None else cls.published_checksum(asset)
        if checksum is None:
            log(f"no published checksum for {asset}; refusing to install it")
            return None

        try:
            binary = fetch(cls.RELEASE_BASE + asset, timeout=cls.TIMEOUT)
        except Exception as error:  # noqa: BLE001
            log(f"could not download {asset}: {error}")
            return None

        actual = hashlib.sha256(binary).hexdigest()
        if actual != checksum:
            log(f"the downloaded {asset} does not match its published checksum, so it was discarded")
            return None

        os.makedirs(os.path.dirname(target), mode=0o755, exist_ok=True)

        # Written under another name, proved, and only then moved into place: a download
        # that dies half way through must not leave a truncated binary where a working one
        # was. 0755 rather than the server's 0700, because here the account that installs it
        # is not the account that runs it.
        staging = target + ".new"
        with open(staging, "wb") as file:
            file.write(binary)
        os.chmod(staging, 0o755)

        version = cls.confirm_it_runs(staging, asset)
        if version is None:
            os.unlink(staging)
            return None

        os.replace(staging, target)

        return version, asset

    @staticmethod
    def confirm_it_runs(path: str, asset: str) -> str | None:
        """
        Run the thing before trusting it.

        A file of the right size with the right checksum can still be unusable — the python
        archive needs an interpreter, a PyInstaller build needs a matching libc. Finding
        that out now, with the old copy still in place, is much better than finding out
        during somebody's first import.
        """
        try:
            done = subprocess.run([path, "--version"], capture_output=True, text=True, timeout=60,
                                  env={"PATH": "/usr/local/bin:/usr/bin:/bin", "LC_ALL": "C"})
        except Exception as error:  # noqa: BLE001
            log(f"the downloaded {asset} could not be run: {error}")
            return None

        version = (done.stdout or "").strip().splitlines()
        if not version or not re.match(r"^\d{4}\.\d{2}\.\d{2}", version[0]):
            log(f"the downloaded {asset} did not report a version, so it was discarded. "
                f"{(done.stderr or '')[-300:].strip()}")
            return None

        return version[0]


def fetch(url: str, timeout: int = 60) -> bytes:
    """A plain GET. GitHub answers some clients differently, so it is given a name."""
    request = urllib.request.Request(url, headers={"User-Agent": "music-radio-worker/1.0"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read()


def sha256_of(path: str) -> str | None:
    try:
        digest = hashlib.sha256()
        with open(path, "rb") as file:
            for block in iter(lambda: file.read(1024 * 1024), b""):
                digest.update(block)
        return digest.hexdigest()
    except OSError:
        return None


