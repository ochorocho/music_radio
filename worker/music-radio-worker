# The version of the job descriptor this script understands. The server sends its own; a
# mismatch is reported loudly rather than left to produce baffling failures on every job.
PROTOCOL = 1

# The runtimes yt-dlp knows how to drive, in its own order of preference. Kept in that
# order so a machine with two installed gets the one yt-dlp itself would have picked.
JS_RUNTIMES = ("deno", "node", "quickjs", "bun")

# Options that would turn "run yt-dlp with these flags" into "run anything at all". The
# server never sends them; refusing them here is what keeps that a fact rather than a
# promise, and it costs one loop over a list.
FORBIDDEN_FLAGS = (
    "--exec",
    "--exec-before-download",
    "--config-location",
    "--config-locations",
    "--load-info-json",
    "--load-info",
    "--batch-file",
)

# How long to wait after a network error before asking again. Backs off so a server that
# is down for an hour is not asked twice a second for an hour.
RETRY_DELAYS = (2, 5, 15, 30, 60)


class Stop(Exception):
    """Raised inside a job when the operator has asked the worker to stop."""


class LeaseLost(Exception):
    """The server no longer considers this job ours: cancelled, taken back, or gone."""


class ApiError(Exception):
    def __init__(self, status: int, code: str, body: str = "") -> None:
        super().__init__(f"HTTP {status}: {code or body}")
        self.status = status
        self.code = code


